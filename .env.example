# Server-side Microsoft Foundry configuration is not required for the local demo.
PULSE_ENABLE_FOUNDRY=false
PULSE_FOUNDRY_ADMIN_TOKEN=
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=

# Configure these in the server shell; start.ps1 does not automatically load .env.
# Leave operator/import capabilities unset for a read-only local fixture demo.
# Generate a unique >=32-character ASCII token locally; never commit its value.
# PULSE_RUNTIME_TOKEN=
# PULSE_IMPORT_TOKEN=
# Optional isolated paths (runtime schema 4 and imported-match schema 2):
# PULSE_RUNTIME_DB_PATH=
# PULSE_DB_PATH=
# PULSE_ENABLE_LOCAL_DATA_ADMIN must remain unset on public/proxied deployments.
