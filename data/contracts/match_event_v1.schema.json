{
  "$defs": {
    "EventType": {
      "enum": [
        "kickoff",
        "pass",
        "carry",
        "shot",
        "goal",
        "save",
        "tackle",
        "interception",
        "pressure",
        "recovery",
        "turnover",
        "clearance",
        "foul",
        "card",
        "substitution",
        "halftime",
        "fulltime"
      ],
      "title": "EventType",
      "type": "string"
    },
    "Point": {
      "properties": {
        "x": {
          "maximum": 100,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 100,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    }
  },
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "match_second": {
      "maximum": 5400,
      "minimum": 0,
      "title": "Match Second",
      "type": "integer"
    },
    "period": {
      "enum": [
        1,
        2
      ],
      "title": "Period",
      "type": "integer"
    },
    "team_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Team Id"
    },
    "actor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actor Id"
    },
    "recipient_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recipient Id"
    },
    "type": {
      "$ref": "#/$defs/EventType"
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "start": {
      "anyOf": [
        {
          "$ref": "#/$defs/Point"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "end": {
      "anyOf": [
        {
          "$ref": "#/$defs/Point"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "possession_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Possession Id"
    },
    "qualifiers": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Qualifiers",
      "type": "object"
    },
    "source_type": {
      "const": "synthetic-generator",
      "default": "synthetic-generator",
      "title": "Source Type",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "generated_at_utc": {
      "format": "date-time",
      "title": "Generated At Utc",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "match_id",
    "sequence",
    "match_second",
    "period",
    "type",
    "generated_at_utc"
  ],
  "title": "MatchEvent",
  "type": "object"
}
